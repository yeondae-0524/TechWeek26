WorldInfo {
  info [
    "TECH WEEK Search and Rescue baseline: TurtleBot3 Burger + LDS-01, controller rescue_robot"
    "Team-made test world (Webots R2025a official PROTOs only). No GPS/Compass input: organizer rule."
  ]
  title "Rescue Baseline"
  basicTimeStep 64
}
